{
  "manifest_version": 3,
  "name": "Quieter",
  "version": "1.0.0",
  "description": "Ultra-lightweight editorial New Tab homepage featuring non-repeating bilingual quotes, customizable typography, bookmarks strip, and glassmorphic shortcuts.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "permissions": [
    "storage",
    "topSites",
    "favicon",
    "contextMenus",
    "bookmarks",
    "unlimitedStorage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
